# forager runtime config. Copy this to .env and fill in.
#
# Precedence at runtime:
#   1. config.json (UI-saved through the Settings panel)  →  highest
#   2. this .env file                                     →  fallback
#   3. hardcoded defaults                                 →  last resort
#
# These values are the *bootstrap* path — they let the daemon boot
# without going through the UI, but anything set via the plugin
# Settings panel overrides whatever's here. So this file is most
# useful for first-time setup or immutable-infrastructure deploys.
# Hand-edited values that overlap with UI-saved fields will be
# silently overridden; the UI shows a small "env" chip next to a
# field when env is the active source.
#
# Never commit your filled-in copy.

# Local Stash (the one with your library).
FORAGER_STASH_URL=http://host.docker.internal:9999
FORAGER_STASH_API_KEY=

# StashDB (note: .org, not .cc).
FORAGER_STASHDB_URL=https://stashdb.org
FORAGER_STASHDB_API_KEY=

# Prowlarr. From inside an OrbStack container on the same host as
# prowlarr, host.docker.internal resolves to the host's loopback —
# i.e., the published 0.0.0.0:9696 of the prowlarr container.
FORAGER_PROWLARR_URL=http://host.docker.internal:9696
FORAGER_PROWLARR_API_KEY=

# Optional. Default cats below cover XXX torrent + usenet on most
# indexer setups; adjust if your indexers tag differently.
FORAGER_PROWLARR_CATEGORIES=6000,6010,6020,6030,6040

# qBittorrent (where grabs go). When unset, torrent /grab returns 503
# but the rest of forager still works.
FORAGER_QBIT_URL=http://host.docker.internal:8083
# Optional. Leave blank if qBit has bypass_local_auth enabled.
FORAGER_QBIT_USERNAME=
FORAGER_QBIT_PASSWORD=
# Must already exist in qBit (the daemon does not auto-create). Point
# this category's save_path at the same staging dir SAB writes to
# (see FORAGER_LIBRARY_ROOT note below) so placement can hardlink.
FORAGER_QBIT_CATEGORY=forager

# SABnzbd (where NZB grabs go). When unset, usenet /grab returns 503.
FORAGER_SAB_URL=http://host.docker.internal:8080
FORAGER_SAB_API_KEY=
# Must already exist in SAB. Configure its `dir` to the staging path.
FORAGER_SAB_CATEGORY=forager

# Library root. When set, forage takes ownership of final file
# placement: hardlinks each finished download out of the client's
# complete dir into <root>/<performer>/<release-filename>. Stash
# scans this root. Optional — leave unset to keep the existing
# arr-stack behaviour of files staying where the client put them.
#
# Architecture note: the qBit/SAB category save_paths AND this root
# must live on the same filesystem inside the forager container, so
# os.Link can hardlink across them. The simplest setup: one bind mount
# (NAS share or local dir) exposed at e.g. /data/media, with the
# clients writing to /data/media/downloads/complete and this set to
# /data/media/library.
FORAGER_LIBRARY_ROOT=

# Phase B — how often the grabs poller ticks, and how long a grab can
# sit completed-but-not-in-Stash before being marked orphaned.
FORAGER_POLL_INTERVAL=60s
FORAGER_ORPHAN_AFTER=6h

# How often the daemon refreshes its performer + studio caches from Stash.
FORAGER_CACHE_REFRESH=6h

# Lock CORS to a single origin if you want; "*" is fine on a private LAN.
FORAGER_ALLOWED_ORIGIN=*

# Optional admin token. When set, /config endpoints require
# Authorization: Bearer <token>. Plugin's Settings panel asks for the
# token on first load and stores it in localStorage. Leave unset for
# tailnet-only deploys.
FORAGER_ADMIN_TOKEN=
